      "purpose": "`authentication` is a production-oriented authentication library for Go services. It turns Basic credentials, opaque bearer tokens, API keys, JWTs, or OIDC ID tokens into an immutable principal. It does not decide whether that principal may perform an action.",
      "lifecycle": "stable",
      "kind": "public library",
      "releasable": true,
      "family": "service-edge",
      "family_label": "Service Edge",
      "family_description": "Request-edge policy, identity, access decisions, routing, middleware, and process lifecycle.",
      "family_order": 2,
      "cohesion": {
        "family": "service-edge",
        "secondary_capabilities": [
          "cryptography-and-secrets",
          "http-and-service-edge",
          "identity-and-access",
          "observability",
          "testing-and-conformance"
        ],
        "responsibility": "Turn Basic credentials, opaque bearer tokens, and API keys into immutable authenticated principals.",
        "non_goals": [
          "Decide whether an authenticated principal may perform an action.",
          "Own application sessions, login flows, token issuance, or credential persistence."
        ],
        "public_package_identifier": "authentication",
        "primary_entry_packages": [
          "github.com/faustbrian/go-authentication"
        ],
        "package_selection": {
          "github.com/faustbrian/go-authentication": "Use for immutable principals, typed redacted credentials, stable failures, composition, and instrumentation contracts.",
          "github.com/faustbrian/go-authentication/apikey": "Use for callback-backed or atomically rotatable static API-key authentication.",
          "github.com/faustbrian/go-authentication/authhttp": "Use for strict HTTP credential extraction, challenges, and authentication-only middleware.",
          "github.com/faustbrian/go-authentication/authlog": "Use to emit bounded secret-safe authentication observations through log/slog.",
          "github.com/faustbrian/go-authentication/authtest": "Use only in tests for deterministic principals, clocks, authenticators, fixtures, and assertions.",
          "github.com/faustbrian/go-authentication/basic": "Use for constant-work static Basic authentication.",
          "github.com/faustbrian/go-authentication/bearer": "Use for opaque bearer-token validators and bounded static token sets."
